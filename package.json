{
  "name": "bazaar-calculator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean:next": "rm -rf .next",
    "clean:next:dev": "rm -rf .next-dev",
    "clean:next:all": "rm -rf .next .next-dev",
    "kill:ports": "for p in 3000 3001 3002; do lsof -ti tcp:$p | xargs kill -9 2>/dev/null || true; done",
    "dev": "npm run clean:next:all && npm run kill:ports && NEXT_DIST_DIR=.next-dev NEXT_DISABLE_WEBPACK_CACHE=1 next dev -p 3000",
    "dev:3000": "npm run dev",
    "dev:3000:clean": "npm run dev",
    "build": "npm run clean:next && next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "sync:bazaardb": "node scripts/sync_bazaardb_data.mjs",
    "sync:bazaardb:r2": "node scripts/sync_bazaardb_to_r2.mjs",
    "build:route-stats": "node scripts/build_route_choice_stats.mjs --db-dir \"/Users/duang/Downloads/BazaarPlusPlus\" --out-file \"public/resources/analytics/route_choice_stats.json\"",
    "build:lineup-index": "node scripts/build_lineup_index_from_archive.mjs",
    "upload:lineup-index:r2": "node scripts/upload_lineup_index_to_r2.mjs",
    "seed:bpp:mock": "node scripts/generate_bpp_mock_seed.mjs 2000 11",
    "seed:bpp:mock:push": "node scripts/seed_bpp_mock_to_supabase.mjs 2000 11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@supabase/supabase-js": "^2.95.3",
    "idb": "^8.0.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "typescript": "^5"
  }
}
